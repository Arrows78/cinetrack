{
  "name": "cinetrack",
  "private": true,
  "version": "0.3.0",
  "description": "A desktop app to track movies, series, watchlists and episode progress, powered by TMDB and built with Tauri, React and SQLite.",
  "keywords": [
    "tauri",
    "react",
    "typescript",
    "sqlite",
    "tmdb",
    "movies",
    "tv-shows",
    "desktop",
    "local-first"
  ],
  "homepage": "https://github.com/Arrows78/cinetrack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arrows78/cinetrack.git"
  },
  "author": "Thomas Jost",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:changed": "node scripts/check-changed-coverage.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "contract:generate": "node scripts/generate-tauri-command-names.mjs",
    "contract:check": "node scripts/generate-tauri-command-names.mjs --check && node scripts/check-contract-drift.mjs && node scripts/check-tauri-command-signatures.mjs",
    "architecture:check": "node scripts/check-feature-boundaries.mjs",
    "cargo:check": "cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "cargo:clippy": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "cargo:clippy:fix": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets --fix -- -D warnings",
    "cargo:format": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "cargo:format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "cargo:test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "perf:database": "cargo test --locked --manifest-path src-tauri/Cargo.toml stats::performance::benchmark_library_progress_and_stats_at_1k_10k_and_50k_scale -- --ignored --nocapture",
    "cargo:coverage": "cargo +nightly llvm-cov --manifest-path src-tauri/Cargo.toml --branch",
    "contract:generate-ts-bindings": "cargo test --locked --manifest-path src-tauri/Cargo.toml export_bindings && prettier --write src/generated/dto",
    "contract:check-ts-bindings": "pnpm contract:generate-ts-bindings && git diff --exit-code -- src/generated/dto",
    "validate:frontend": "pnpm contract:check && pnpm architecture:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm build",
    "validate:backend": "pnpm cargo:check && pnpm cargo:clippy && pnpm cargo:format:check && pnpm cargo:test && pnpm contract:check-ts-bindings",
    "validate": "pnpm validate:frontend && pnpm validate:backend",
    "tauri": "tauri"
  },
  "dependencies": {
    "@choochmeque/tauri-plugin-sharekit-api": "0.3.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/query-sync-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.2.0",
    "@tauri-apps/plugin-deep-link": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-global-shortcut": "^2.2.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-stronghold": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.2.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "framer-motion": "^13.1.1",
    "i18next": "^26.4.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-virtuoso": "^4.18.12",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-sql": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ],
    "overrides": {
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@5": "^5.0.9",
      "js-yaml": "^4.3.1"
    }
  }
}
