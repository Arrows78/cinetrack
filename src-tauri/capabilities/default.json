{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main desktop capability for CineTrack",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "deep-link:default",
    "dialog:allow-open",
    "notification:default",
    "opener:default",
    "os:default",
    "stronghold:default",
    "process:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPDATA/backups/**" }, { "path": "$APPDATA/logs/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/backups" }, { "path": "$APPDATA/logs" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA/backups/**" }, { "path": "$APPDATA/logs/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/backups/**" }, { "path": "$APPDATA/logs/**" }]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [{ "path": "$APPDATA/backups/**" }, { "path": "$APPDATA/logs/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/backups/**" }, { "path": "$APPDATA/logs/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$APPDATA/backups/**" }]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "$APPDATA/logs/**" }]
    }
  ]
}
