{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main desktop capability for CineTrack. Every non-`fs`/non-`dialog` permission below is spelled out at the individual-command level rather than as a plugin's `:default` set — each `:default` bundles commands this app never calls (e.g. notification:default alone grants 16 commands; this app uses 3), so keeping the narrower explicit list here is what makes an unused, newly-reachable command an actual diff instead of a silent grant. See each plugin's own permission reference (https://v2.tauri.app/plugin/<name>/) for what `:default` would have included instead, and grep the frontend for the plugin import to re-derive this list if it ever needs revisiting.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "deep-link:allow-get-current",
    "dialog:allow-open",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "opener:allow-default-urls",
    "os:allow-os-type",
    "stronghold:allow-initialize",
    "stronghold:allow-create-client",
    "stronghold:allow-load-client",
    "stronghold:allow-get-store-record",
    "stronghold:allow-save-store-record",
    "stronghold:allow-save",
    "process:allow-restart",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPDATA/backups/**" }, { "path": "$APPDATA/logs/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/backups" }, { "path": "$APPDATA/logs" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA/backups/**" }, { "path": "$APPDATA/logs/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/backups/**" }, { "path": "$APPDATA/logs/**" }]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [{ "path": "$APPDATA/backups/**" }, { "path": "$APPDATA/logs/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/backups/**" }, { "path": "$APPDATA/logs/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$APPDATA/backups/**" }]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "$APPDATA/logs/**" }]
    }
  ]
}
