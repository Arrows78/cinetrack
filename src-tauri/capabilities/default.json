{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main desktop capability for CineTrack",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "deep-link:default",
    "notification:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "stronghold:default",
    "process:default",
    "updater:default",
    "autostart:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file"
  ]
}
