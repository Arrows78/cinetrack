VITE_TMDB_API_TOKEN=your_tmdb_bearer_token_here

# Supabase Auth. Use the public publishable key only. Never expose a secret or service-role key.
# Leave VITE_AUTH_REQUIRED unset or "false" for the default, account-free local experience;
# set it to "true" only once Supabase is actually configured (see docs/auth.md).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
VITE_AUTH_REQUIRED=false

# OAuth returns to the custom protocol in Tauri and to this URL in web preview.
# Add both exact values to Supabase Authentication > URL Configuration > Redirect URLs.
VITE_AUTH_DESKTOP_REDIRECT_URL=cinetrack://auth/callback
VITE_AUTH_WEB_REDIRECT_URL=http://localhost:1420/

# Keep these values aligned with Supabase Authentication > Sign In / Providers > Email.
VITE_AUTH_OTP_LENGTH=6
VITE_AUTH_OTP_RESEND_SECONDS=60

VITE_TERMS_URL=https://example.com/terms
VITE_PRIVACY_URL=https://example.com/privacy
