VITE_TMDB_API_TOKEN=your_tmdb_bearer_token_here

# Clerk (identity). Publishable key only. Leave VITE_AUTH_REQUIRED unset or
# "false" for the default, account-free local experience; set it to "true"
# only once Clerk is actually configured (see docs/auth.md).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
VITE_AUTH_REQUIRED=false

# Supabase Postgres/Realtime only — sync_*, community_*, account_profiles
# and their RLS policies. Never Supabase Auth: Clerk is the only identity
# provider (see the Clerk "Third-Party Auth" integration activated in both
# dashboards, docs/auth.md). Use the public publishable key only. Never
# expose a secret or service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Bundled desktop / iOS OAuth return. `pnpm tauri dev` ignores this and
# uses http://127.0.0.1:7420/auth/callback (no .app for Launch Services).
# Add both URLs to Clerk Dashboard → Native applications → Redirect URLs.
VITE_AUTH_DESKTOP_REDIRECT_URL=cinetrack://auth/callback
VITE_AUTH_WEB_REDIRECT_URL=http://localhost:1420/

# Clerk's email code is a fixed 6-digit code — VITE_AUTH_OTP_LENGTH no
# longer applies. Keep this aligned with Clerk Dashboard > Sessions if its
# rate limits ever change.
VITE_AUTH_OTP_RESEND_SECONDS=60

VITE_TERMS_URL=https://example.com/terms
VITE_PRIVACY_URL=https://example.com/privacy
